---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BookSection from '../components/BookSection.astro';

const categories = ['all', 'tattoo', 'mural', 'artwork'] as const;
type Category = (typeof categories)[number];

interface GalleryItem {
  prefix: string;
  num: number;
  category: Category;
}

const gallery: GalleryItem[] = [
  { prefix: 'artwork', num: 3, category: 'artwork' },
  { prefix: 'tattoos', num: 7, category: 'tattoo' },
  { prefix: 'artwork', num: 1, category: 'artwork' },
  { prefix: 'tattoos', num: 2, category: 'tattoo' },
  { prefix: 'artwork', num: 11, category: 'artwork' },
  { prefix: 'tattoos', num: 5, category: 'tattoo' },
  { prefix: 'artwork', num: 9, category: 'mural' },
  { prefix: 'tattoos', num: 10, category: 'tattoo' },
  { prefix: 'artwork', num: 6, category: 'artwork' },
  { prefix: 'tattoos', num: 4, category: 'tattoo' },
  { prefix: 'artwork', num: 12, category: 'mural' },
  { prefix: 'tattoos', num: 1, category: 'tattoo' },
  { prefix: 'artwork', num: 8, category: 'artwork' },
  { prefix: 'tattoos', num: 8, category: 'tattoo' },
  { prefix: 'artwork', num: 4, category: 'artwork' },
  { prefix: 'tattoos', num: 12, category: 'tattoo' },
  { prefix: 'artwork', num: 2, category: 'artwork' },
  { prefix: 'tattoos', num: 6, category: 'tattoo' },
  { prefix: 'artwork', num: 7, category: 'artwork' },
  { prefix: 'tattoos', num: 3, category: 'tattoo' },
  { prefix: 'artwork', num: 5, category: 'mural' },
  { prefix: 'tattoos', num: 9, category: 'tattoo' },
  { prefix: 'artwork', num: 10, category: 'artwork' },
  { prefix: 'tattoos', num: 11, category: 'tattoo' },
];
---

<Layout title="Artwork | Art District Inc.">
  <Nav currentPage="artwork" />
  <div class="page-title">
    <div class="label">PORTFOLIO</div>
    <div class="flex">
      <h1>Artwork</h1>
      <div class="sub">FROM SKIN TO STREETS · RAW VISUAL CULTURE</div>
    </div>
  </div>

  <div class="filter-bar">
    <div class="filter-group">
      <span class="filter active" data-filter="all">ALL</span>
      <span class="filter" data-filter="tattoo">TATTOOS</span>
      <span class="filter" data-filter="mural">MURALS</span>
      <span class="filter" data-filter="artwork">ARTWORK</span>
    </div>
    <div class="filter-count">{gallery.length} pieces</div>
  </div>

  <div class="gallery-section masonry">
    {gallery.map(i => (
      <div class="artwork-img" data-category={i.category}>
        <img src={"/ADI_" + i.prefix + i.num + ".jpg"} alt={i.prefix + " " + i.num} />
        <span class="img-label">{i.category.toUpperCase()}</span>
      </div>
    ))}
  </div>

  <div class="gallery-footer">
    <div class="gallery-footer-count">— Showing <span id="visible-count">{gallery.length}</span> of {gallery.length} pieces —</div>
  </div>

  <div class="lightbox" id="lightbox">
    <img id="lightbox-img" src="" alt="" />
  </div>

  <script>
    const filters = document.querySelectorAll('.filter');
    const items = document.querySelectorAll('.artwork-img');
    const countEl = document.getElementById('visible-count');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        filters.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const cat = btn.dataset.filter;
        let visible = 0;
        items.forEach(el => {
          if (cat === 'all' || el.dataset.category === cat) {
            el.classList.remove('hidden');
            visible++;
          } else {
            el.classList.add('hidden');
          }
        });
        if (countEl) countEl.textContent = visible;
      });
    });

    document.querySelectorAll('.artwork-img img').forEach(img => {
      img.addEventListener('click', () => {
        const lb = document.getElementById('lightbox');
        const lbImg = document.getElementById('lightbox-img');
        lbImg.src = img.src;
        lbImg.alt = img.alt;
        lb.classList.add('open');
      });
    });
    document.getElementById('lightbox')?.addEventListener('click', () => {
      document.getElementById('lightbox').classList.remove('open');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') document.getElementById('lightbox')?.classList.remove('open');
    });
  </script>

  <div class="cta-banner">
    <div>
      <div class="meta-label">INTERESTED IN A PIECE?</div>
      <div class="title-lg">Every piece is custom. Let's build yours.</div>
    </div>
    <a href="/contact" class="btn">BOOK NOW ›</a>
  </div>

  <BookSection />
  <Footer />
</Layout>

<style>
  .page-title {
    padding: 40px 40px 30px;
    border-bottom: 1.5px solid var(--border-light);
    background: var(--card-bg);
  }

  .page-title .label {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: var(--brand-orange);
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .page-title .flex {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .page-title h1 {
    margin: 0;
    color: var(--white);
  }

  .page-title .sub {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    flex-shrink: 0;
  }

  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 40px;
    border-bottom: 1.5px solid var(--border-light);
    background: var(--card-bg);
  }

  .filter-group {
    display: flex;
    gap: 8px;
  }

  .filter {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    padding: 6px 14px;
    border: 1.5px solid var(--border-light);
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.2s;
    color: var(--white);
  }

  .filter.active,
  .filter:hover {
    background: var(--brand-orange);
    color: var(--white);
    border-color: var(--brand-orange);
  }

  .filter-count {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
  }

  .gallery-section {
    padding: 32px 40px;
    border-bottom: 1.5px solid var(--border-light);
  }

  .masonry {
    column-count: 4;
    column-gap: 12px;
  }

  .masonry .artwork-img {
    break-inside: avoid;
    margin-bottom: 12px;
  }

  .placeholder-img {
    background: var(--card-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.5);
    font-family: var(--font-body);
    font-size: 0.75rem;
    text-transform: uppercase;
    text-align: center;
    padding: 20px;
  }

  .artwork-img {
    position: relative;
    line-height: 0;
    overflow: hidden;
    background: var(--card-bg);
    cursor: pointer;
    border-radius: 2px;
    transition: opacity 0.3s;
  }

  .artwork-img.hidden {
    display: none;
  }

  .artwork-img img {
    width: 100%;
    height: auto;
    display: block;
    border: 1.5px solid var(--brand-orange);
  }

  .img-label {
    position: absolute;
    top: 8px;
    left: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.625rem;
    letter-spacing: 1.5px;
    padding: 3px 8px;
    background: var(--brand-orange);
    color: #fff;
    text-transform: uppercase;
    pointer-events: none;
    z-index: 2;
  }

  .tag {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    padding: 6px 12px;
    border: 1.5px solid var(--border-light);
    text-transform: uppercase;
    background: var(--card-bg);
    color: var(--white);
  }

  .tag-sm {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    padding: 4px 8px;
    border: 1px solid var(--border-light);
    text-transform: uppercase;
    background: var(--card-bg);
    color: var(--white);
  }

  .gallery-footer {
    padding: 32px 40px;
    border-bottom: 1.5px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .gallery-footer div {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
  }

  .btn-sm {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 20px;
    border: 1.5px solid var(--border-light);
    cursor: pointer;
    transition: all 0.2s;
    background: var(--card-bg);
    color: var(--white);
  }

  .btn-sm:hover {
    background: var(--border-light);
    color: var(--near-black);
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(8px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 4px;
    cursor: default;
  }

  .cta-banner {
    padding: 60px 40px;
    border-bottom: 1.5px solid var(--border-light);
    background: var(--card-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .meta-label {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--brand-orange);
    margin-bottom: 8px;
  }

  .title-lg {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    color: var(--white);
  }

  .btn {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 14px 28px;
    border: 2px solid var(--brand-orange);
    background: var(--brand-orange);
    color: var(--white);
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn:hover {
    background: transparent;
    border-color: var(--brand-orange);
    color: var(--brand-orange);
  }

  @media (max-width: 1024px) {
    .masonry { column-count: 3; }
  }

  @media (max-width: 768px) {
    .masonry { column-count: 2; }
  }

  @media (max-width: 600px) {
    .page-title { padding: 24px 16px; }
    .page-title .flex { flex-direction: column; align-items: flex-start; }
    .page-title h1 { font-size: 24px; }
    .filter-bar { flex-direction: column; gap: 12px; align-items: flex-start; padding: 16px; }
    .filter-group { flex-wrap: wrap; }
    .gallery-section { padding: 24px 16px; }
    .masonry { column-count: 2; }
    .gallery-footer { padding: 24px 16px; flex-direction: column; gap: 12px; }
    .cta-banner { padding: 40px 24px; flex-direction: column; text-align: center; }
  }
</style>
